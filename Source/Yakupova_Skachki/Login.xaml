<Window x:Class="Yakupova_Skachki.Login" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Скачки · Вход" Width="710" Height="430" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" Background="#F6F5EF" FontFamily="Segoe UI" Icon="/res/logo.png">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Background="#193F33" Padding="24"><StackPanel VerticalAlignment="Center"><Image Source="/res/logo.png" Height="100"/><TextBlock Text="Скачки" FontSize="37" Foreground="White" HorizontalAlignment="Center"/><TextBlock Text="Журнал ипподрома" Foreground="#D9C693" HorizontalAlignment="Center"/></StackPanel></Border>
<StackPanel Grid.Column="1" Margin="36" VerticalAlignment="Center"><TextBlock Text="Вход в систему" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,18"/><Label Target="{Binding ElementName=Username}" Content="Логин"/><TextBox Name="Username" Padding="8" FontSize="16"/><Label Target="{Binding ElementName=Secret}" Content="Пароль"/><PasswordBox Name="Secret" Padding="8" FontSize="16"/><Button Content="Войти" IsDefault="True" Click="Enter" Margin="0,18,0,4"/><TextBlock Name="Notice" TextWrapping="Wrap" Foreground="#912C20"/></StackPanel></Grid></Window>
