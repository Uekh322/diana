<Page x:Class="Yakupova_Skachki.HorsesPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Yakupova_Skachki" FontFamily="Segoe UI">
<DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Каталог лошадей" FontSize="25" FontWeight="SemiBold" Foreground="#193F33" Margin="4,0,0,8"/>
<WrapPanel><StackPanel Margin="4"><TextBlock Text="Поиск по каталогу"/><TextBox Name="TBSearch" Width="200" Height="30" TextChanged="TBSearch_TextChanged"/></StackPanel>
<StackPanel Margin="4"><TextBlock Text="Пол"/><ComboBox Name="ComboCateghory" Width="110" Height="30" SelectionChanged="ComboCateghory_SelectionChanged"><TextBlock>Все</TextBlock><TextBlock>Кобыла</TextBlock><TextBlock>Жеребец</TextBlock><TextBlock>Мерин</TextBlock></ComboBox></StackPanel>
<StackPanel Margin="4"><TextBlock Text="Сортировка"/><ComboBox Name="ComboBoh" Width="180" Height="30" SelectionChanged="ComboBoh_SelectionChanged"><TextBlock>Все</TextBlock><TextBlock>Кличка от А до Я</TextBlock><TextBlock>Кличка от Я до А</TextBlock><TextBlock>По возрасту младше</TextBlock><TextBlock>По возрасту старше</TextBlock></ComboBox></StackPanel></WrapPanel>
<WrapPanel Name="Actions"><Button Content="Добавить лошадь" Click="BtnAdd_Click"/><Button Content="Добавить заезд" Click="BtnAddZaezd_Click"/><Button Content="Добавить владельца" Click="BtnAddVlad_Click"/></WrapPanel></StackPanel>
<TextBlock Name="TBRecordCount" DockPanel.Dock="Bottom" Margin="4,6" Foreground="#476959"/>
<ListView Name="HorsesListView" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListView.ItemTemplate><DataTemplate>
<Border Background="White" BorderBrush="#DCE5DC" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<Image Source="{Binding HorsePhotoPath, TargetNullValue=/res/picture.png}" Height="140" Stretch="UniformToFill"/>
<StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="24" FontWeight="SemiBold" Foreground="#193F33"/><TextBlock><Run Text="{Binding Gender,Mode=OneWay}"/> · <Run Text="{Binding BirthDate, StringFormat=dd.MM.yyyy,Mode=OneWay}"/> · <Run Text="{Binding Age,Mode=OneWay}"/> лет</TextBlock><TextBlock Text="{Binding OwnerFullName,StringFormat=Владелец: {0}}" Margin="0,5,0,0"/><TextBlock Text="{Binding OwnerPhone}"/><TextBlock Text="{Binding JockeysList,StringFormat=Жокеи: {0},TargetNullValue=Жокеи не указаны}" TextWrapping="Wrap"/><TextBlock Text="{Binding BestPlace,StringFormat=Лучшее место: {0},TargetNullValue=Место не установлено}"/></StackPanel>
<StackPanel Grid.Column="2" VerticalAlignment="Center"><Button Tag="{Binding}" Click="MenuItem_Click"><TextBlock Text="{Binding RacesCount, StringFormat=Заезды ({0})}"/></Button><StackPanel Visibility="{Binding EditVisibility,RelativeSource={RelativeSource AncestorType={x:Type local:HorsesPage}}}"><Button Background="#E5EDE6" Foreground="#264839" Content="Редактировать" Tag="{Binding}" Click="BtnEdit_Click"/><Button Content="Удалить" Background="#F6ECE9" Foreground="#873F36" Tag="{Binding}" Click="BtnDelete_Click"/></StackPanel></StackPanel>
</Grid></Border></DataTemplate></ListView.ItemTemplate></ListView></DockPanel></Page>
