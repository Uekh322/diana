<Application x:Class="Yakupova_Skachki.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Yakupova_Skachki"
             StartupUri="Login.xaml">
    <Application.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="34"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="13,7"/>
            <Setter Property="Background" Value="#235844"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Edge" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Edge" Property="Opacity" Value=".84"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Edge" Property="Opacity" Value=".45"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Edge" Property="BorderBrush" Value="#D5A54D"/><Setter TargetName="Edge" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="DataGrid"><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="38"/><Setter Property="ColumnHeaderHeight" Value="38"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E2E8E2"/><Setter Property="AlternatingRowBackground" Value="#F4F7F3"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="15"/></Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Padding" Value="8,4"/><Setter Property="Background" Value="#DFE8DF"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    </Application.Resources>
</Application>
