<Window x:Class="Yakupova_Skachki.AddEditOwnerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Новый владелец" Width="510" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" Background="#F6F5EF" Icon="/res/logo.png">
    <StackPanel Margin="24">
        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="26" FontWeight="SemiBold" Foreground="#193F33" Margin="0,0,0,16"/>
        <Border Background="White" CornerRadius="10" Padding="18,8,18,18">
            <StackPanel>
                <TextBlock Text="Фамилия" FontWeight="SemiBold" Foreground="#415B4E" Margin="0,8,0,4"/>
                <TextBox Height="34" FontSize="15" VerticalContentAlignment="Center" Name="TbLastName"/>
                <TextBlock Text="Имя" FontWeight="SemiBold" Foreground="#415B4E" Margin="0,8,0,4"/>
                <TextBox Height="34" FontSize="15" VerticalContentAlignment="Center" Name="TbFirstName"/>
                <TextBlock Text="Телефон" FontWeight="SemiBold" Foreground="#415B4E" Margin="0,8,0,4"/>
                <TextBox Height="34" FontSize="15" VerticalContentAlignment="Center" Name="TbPhone" MaxLength="18" PreviewTextInput="TbPhone_PreviewTextInput" TextChanged="TbPhone_TextChanged"/>
            </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Name="BtnCancel" Content="Отмена" Background="#E3EAE4" Foreground="#284638" MinWidth="90" IsCancel="True" Click="BtnCancel_Click"/>
            <Button Name="BtnSave" Content="Сохранить" MinWidth="110" IsDefault="True" Click="BtnSave_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
